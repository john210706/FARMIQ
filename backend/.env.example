# Supabase Dashboard -> Project Settings -> Database -> Connection string
# Use the transaction pooler (port 6543) for the running API.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Use the direct connection (port 5432) for Prisma schema changes and seeding.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

JWT_SECRET="replace-with-a-long-random-secret"
PORT=3000
FRONTEND_URL="http://localhost:5173"

# Sandbox never charges money and is disabled when NODE_ENV=production.
PAYMENT_MODE="sandbox"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Optional SMS OTP, SMS commands and phone assistance. Do not expose to Vite.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Create a Twilio Verify service for login/reset OTP (VA...). Separate from booking SMS.
TWILIO_VERIFY_SERVICE_SID=""
TWILIO_FROM=""
PUBLIC_WEBHOOK_ORIGIN=""

# Set an available Gemini model explicitly; guided help works without it.
GEMINI_API_KEY=""
GEMINI_MODEL=""

# Only enable for a separate development/demo database.
ALLOW_DEMO_SEED="false"
SMS_OUTBOX_ENABLED=false

# Optional private Supabase Storage. Keep this key on the backend only.
STORAGE_DRIVER=local
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="farmiq-private"
# Local files remain readable when cloud storage is enabled. Persist this directory.
# UPLOAD_DIR="/absolute/persistent/path"

# Optional ClamAV daemon on a trusted internal network. Never expose its port publicly.
CLAMAV_HOST=""
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false

# Set only to the exact number of trusted reverse proxies between clients and this API.
TRUST_PROXY_HOPS=0
LOG_REQUESTS=false
