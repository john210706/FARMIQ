{
  "name": "farmiq-backend",
  "version": "1.0.0",
  "private": true,
  "description": "FarmIQ Express API for Supabase PostgreSQL",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node seed.js",
    "db:studio": "prisma studio",
    "check": "node --check server.js && node --check seed.js && prisma validate"
  },
  "prisma": {
    "seed": "node seed.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "prisma": "^5.14.0"
  }
}
