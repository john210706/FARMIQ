{
  "name": "farmiq-backend",
  "version": "1.0.0",
  "private": true,
  "description": "FarmIQ Express API for Supabase PostgreSQL",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node seed-demo.js",
    "learning:seed": "node seed-learning.js",
    "db:studio": "prisma studio",
    "check": "node --check server.js && node --check seed-demo.js && prisma validate",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "db:migrate": "prisma migrate deploy"
  },
  "prisma": {
    "seed": "node seed-demo.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "twilio": "^6.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "prisma": "^5.14.0",
    "supertest": "^7.1.1"
  }
}
